{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "uBot Manager",
  "mainBinaryName": "ubot-manager",
  "version": "0.1.0",
  "identifier": "com.astreox.ubotmanager",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../app"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../app"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "uBot Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#1e1f22"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "AstreoX",
    "homepage": "https://github.com/AstreoX/uBotManager",
    "copyright": "Copyright AstreoX",
    "category": "DeveloperTool",
    "shortDescription": "Package manager for the uBot Unreal Engine plugins",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
